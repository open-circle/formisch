{
  "name": "@formisch/methods",
  "description": "The lightweight, schema-first, and fully type-safe form library for React, Solid, Vue, Svelte and more",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Fabian Hiller",
  "homepage": "https://formisch.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-circle/formisch.git"
  },
  "keywords": [
    "modular",
    "typescript",
    "schema",
    "validation",
    "parsing",
    "bundle-size",
    "type-safe"
  ],
  "type": "module",
  "exports": {
    "./angular": {
      "types": "./dist/index.angular.d.ts",
      "default": "./dist/index.angular.js"
    },
    "./honox": {
      "types": "./dist/index.honox.d.ts",
      "default": "./dist/index.honox.js"
    },
    "./preact": {
      "types": "./dist/index.preact.d.ts",
      "default": "./dist/index.preact.js"
    },
    "./qwik": {
      "types": "./dist/index.qwik.d.ts",
      "default": "./dist/index.qwik.js"
    },
    "./react": {
      "types": "./dist/index.react.d.ts",
      "default": "./dist/index.react.js"
    },
    "./react-native": {
      "types": "./dist/index.react-native.d.ts",
      "default": "./dist/index.react-native.js"
    },
    "./solid": {
      "types": "./dist/index.solid.d.ts",
      "default": "./dist/index.solid.js"
    },
    "./svelte": {
      "types": "./dist/index.svelte.d.ts",
      "default": "./dist/index.svelte.js"
    },
    "./vue": {
      "types": "./dist/index.vue.d.ts",
      "default": "./dist/index.vue.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --typecheck",
    "coverage": "vitest run --coverage --isolate",
    "lint": "eslint \"src/**/*.ts*\" && tsc --noEmit",
    "lint.fix": "eslint \"src/**/*.ts*\" --fix",
    "format": "prettier --write ./src",
    "format.check": "prettier --check ./src",
    "build": "tsdown"
  },
  "devDependencies": {
    "@angular/core": "^22.0.0",
    "@formisch/core": "workspace:*",
    "@formisch/eslint-config": "workspace:*",
    "@types/node": "24.0.13",
    "@types/react": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.31.0",
    "jsdom": "^26.1.0",
    "rolldown": "1.0.0-beta.26",
    "rolldown-plugin-dts": "^0.13.13",
    "tsdown": "^0.16.8",
    "typescript": "^5.8.3",
    "valibot": "^1.4.1",
    "vitest": "4.1.7"
  },
  "peerDependencies": {
    "@angular/core": ">=19 <23",
    "react": ">=16.8.0 <20",
    "typescript": ">=5 <8",
    "valibot": ">=1.4.1 <2"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
