{
  "name": "@formisch/solid",
  "description": "The lightweight, schema-first, and fully type-safe form library for SolidJS",
  "version": "2.0.0-next.0",
  "license": "MIT",
  "author": "Fabian Hiller",
  "homepage": "https://formisch.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-circle/formisch.git"
  },
  "keywords": [
    "solid",
    "solidjs",
    "solid-form",
    "form",
    "forms",
    "form-validation",
    "validation",
    "schema",
    "typescript",
    "type-safe",
    "signals",
    "bundle-size",
    "modular",
    "valibot"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "worker": "./dist/index.ssr.js",
      "browser": "./dist/index.js",
      "deno": "./dist/index.ssr.js",
      "node": "./dist/index.ssr.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internals": {
      "types": "./dist/internals.d.ts",
      "import": "./dist/internals.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --typecheck",
    "lint": "eslint \"src/**/*.ts*\" && tsc --noEmit",
    "lint.fix": "eslint \"src/**/*.ts*\" --fix",
    "format": "prettier --write ./src",
    "format.check": "prettier --check ./src",
    "build": "vite build && vite build --ssr src/index.tsx && tsdown",
    "test:artifacts": "node scripts/test-artifacts.mjs"
  },
  "devDependencies": {
    "@formisch/core": "workspace:*",
    "@formisch/eslint-config": "workspace:*",
    "@formisch/methods": "workspace:*",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@types/node": "24.0.13",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.31.0",
    "eslint-plugin-solid": "^0.14.5",
    "jsdom": "^26.1.0",
    "rollup": "^4.45.0",
    "solid-js": "2.0.0-rc.13",
    "tsdown": "^0.16.8",
    "typescript": "^5.8.3",
    "valibot": "^1.4.1",
    "vitest": "4.1.7",
    "@solidjs/web": "2.0.0-rc.13",
    "@solidjs/vite-plugin": "3.0.0-next.46",
    "vite": "8.1.5"
  },
  "peerDependencies": {
    "solid-js": "^2.0.0-rc.13",
    "typescript": ">=5 <8",
    "valibot": ">=1.4.1 <2",
    "@solidjs/web": "^2.0.0-rc.13"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "browser": {},
  "typesVersions": {}
}
