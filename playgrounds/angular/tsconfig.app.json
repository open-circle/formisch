{
  // `@formisch/angular` resolves through the built workspace package, so run
  // `pnpm build` in `frameworks/angular` after changing it. Do not shortcut
  // this with a `paths` entry pointing at `frameworks/angular/src`: Angular's
  // template type checker builds its type constructors from the declaration
  // files, and against the sources it falls back to the generic defaults,
  // which rejects every valid field path with more than one segment.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "outDir": "./node_modules/.tmp/app",
    "rootDir": "./src",
    "rewriteRelativeImportExtensions": true,
    /* Angular */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "strictPropertyInitialization": false,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "include": ["src"]
}
