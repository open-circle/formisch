{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client"],

    /* Hono JSX Config */
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "include": ["app"]
}
