  },
  "devDependencies": {
    "@formisch/eslint-config": "workspace:*",
    "@hono/vite-build": "^1.11.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "tailwindcss": "^4.1.17",
    "typescript": "~6.0.3",
    "vite": "^7.2.4"
